# AI PR review — {{ project_name }}
# Assistive, NOT a merge gate (the gate is ci.yml). Runs the multi-subagent `pr-review`
# skill and posts inline comments. Cost-gated: code paths only, skips drafts and the
# `skip-ai-review` label, and does not re-run on push (synchronize).
name: PR Review

on:
  pull_request:
    types: [opened, ready_for_review]
    branches: [main]
    paths:
{%- for glob in runtime_paths.split(",") %}
      - '{{ glob | trim }}'
{%- endfor %}
      - '.agents/**'

jobs:
  review:
    name: AI review
    runs-on: ubuntu-latest
    if: >
      github.event.pull_request.draft == false &&
      !contains(github.event.pull_request.labels.*.name, 'skip-ai-review')
    permissions:
      contents: read
      pull-requests: write
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      # Wire your agent runner here (e.g. the Claude Code GitHub Action) and point it at
      # the `pr-review` skill. It must run with comment-only permissions — never approve,
      # request-changes, or modify files.
      - name: Run pr-review skill
        run: echo "Configure your agent runner to execute the pr-review skill on PR #{% raw %}${{ github.event.pull_request.number }}{% endraw %}"
