{% if task_runner == "just" -%}
# {{ project_name }} — task runner (the stack-agnostic seam).
#
# Skills, CI, and AGENTS.md call these recipes by ROLE. This file is the only place
# real stack commands appear — swap the bodies and the whole harness follows.
#
# The recipes below are placeholders — run the fg-bootstrap skill to fill them from a
# short interview, or edit by hand.
#
#   just            # list recipes
#   just verify     # the pre-commit gate (lint + typecheck + test)

# Show available recipes.
default:
    @just --list

# Static lint.
lint:
{% if lint_cmd %}    {{ lint_cmd }}{% else %}    @echo "no lint command configured — edit the justfile"{% endif %}

# Type / static analysis.
typecheck:
{% if typecheck_cmd %}    {{ typecheck_cmd }}{% else %}    @echo "no typecheck command configured — edit the justfile"{% endif %}

# Unit tests.
test:
{% if test_cmd %}    {{ test_cmd }}{% else %}    @echo "no test command configured — edit the justfile"{% endif %}

# Production build.
build:
{% if build_cmd %}    {{ build_cmd }}{% else %}    @echo "no build command configured — edit the justfile"{% endif %}

{% if e2e_cmd -%}
# End-to-end tests.
e2e:
    {{ e2e_cmd }}

{% endif -%}
# The pre-commit gate — mirrors CI. Everything must pass before you commit.
verify: lint typecheck test

# Rebuild .claude/ and .github/ adapters from .agents/skills/ (source of truth).
sync-adapters:
    node tools/sync-adapters.mjs
{%- elif task_runner == "make" -%}
